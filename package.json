{
  "name": "otcora",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @otcora/web",
    "prebuild": "npm run data:prepare",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:prepare": "npm run data:build-core-catalog",
    "data:sitemap": "npm run sitemap -w @otcora/data",
    "data:import-csv": "npm run import-csv -w @otcora/data",
    "data:scrape-missing": "npm run scrape-missing -w @otcora/data",
    "data:build-core-catalog": "npm run build-core-catalog -w @otcora/data",
    "data:export-abdm-v2": "npm run export-abdm-v2 -w @otcora/data --",
    "data:enrich-abdm-generics-v2": "npm run enrich-abdm-generics-v2 -w @otcora/data --",
    "data:enrich-abdm-brands-v2": "npm run enrich-abdm-brands-v2 -w @otcora/data --",
    "data:enrich-abdm-substances-v2": "npm run enrich-abdm-substances-v2 -w @otcora/data --",
    "data:finalize-abdm-v2": "npm run finalize-abdm-v2 -w @otcora/data --"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
